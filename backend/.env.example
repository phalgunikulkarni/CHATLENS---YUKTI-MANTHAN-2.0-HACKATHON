# ChatLens backend environment variables (placeholders only — no real secrets).
# Copy to `.env` (or export in your shell) and fill in real values locally.
# NOTE: backend/client_secret.json is gitignored; never commit real secrets.

# --- Google Photos connector (Picker API) ---

# Path to the OAuth client secret JSON downloaded from Google Cloud Console.
# Defaults to backend/client_secret.json if unset.
GOOGLE_CLIENT_SECRET_FILE=./client_secret.json

# OAuth redirect URI. MUST exactly match an Authorized redirect URI configured
# on the OAuth client in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connectors/google/callback

# Where the OAuth callback redirects the browser back to after connecting.
CHATLENS_FRONTEND_ORIGIN=http://localhost:5173

# Max number of picked images to import per sync. Allowed: 10, 25, 50, 100.
GOOGLE_IMPORT_LIMIT=25

# How long (seconds) to wait for the user to finish picking, and poll interval.
GOOGLE_PICKER_POLL_TIMEOUT=300
GOOGLE_PICKER_POLL_INTERVAL=3
